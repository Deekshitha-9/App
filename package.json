{
  "name": "OrderIssuseManagment",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-customer": "cds watch --open customer/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy OrderIssuseManagment --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-order": "cds watch --open order/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-approver": "cds watch --open approver/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-custtoorder": "cds watch --open custtoorder/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-approval": "cds watch --open approval/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/customer",
    "app/order",
    "app/approver",
    "app/customer",
    "app/custtoorder",
    "app/approval"
  ],
  "cds": {
    "requires": {
      "db": "hana"
    }
  }
}
