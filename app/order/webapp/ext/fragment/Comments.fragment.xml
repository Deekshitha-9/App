<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:macros="sap.fe.macros">
	<VBox id="_IDGenVBox1" core:require="{ handler: 'order/ext/fragment/Comments'}">
    <VBox id="_IDGenVBox"
        width="100%"
        core:require="{ handler: 'order/ext/fragment/Comments'}">

        <HBox id="_IDGenHBox2"
            width="100%"
            justifyContent="End">

        <Button id="_IDGenButton1"
                text="View All Comments"
                type="Emphasized"
                press="handler.onAddComment"
                enabled="{= !${IsActiveEntity} }" />
        </HBox>

        <!-- Comment box FIRST -->
        <TextArea
            id="Input"
            width="100%"
            rows="6"
            placeholder="Enter your comment..."
            editable="{= !${IsActiveEntity} }"
            class="sapUiSmallMarginBottom" />

    </VBox>
       
</VBox>
</core:FragmentDefinition>